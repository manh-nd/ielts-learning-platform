# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_DB=ielts_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
# Internal database URL for app container connecting to postgres service in Docker
DATABASE_URL=postgresql://postgres:replace_with_a_secure_postgres_password@postgres:5432/ielts_platform

# ==============================================================================
# Application Configuration
# ==============================================================================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
# Public base URL of your domain handled by Nginx Proxy Manager
NEXT_PUBLIC_APP_URL=https://ielts.yourdomain.com

# ==============================================================================
# Better Auth Configuration
# ==============================================================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_random_32_character_string
BETTER_AUTH_URL=https://ielts.yourdomain.com
# Comma-separated list of teacher emails granted teacher role on sign up
TEACHER_EMAILS=teacher@yourdomain.com,admin@yourdomain.com

# ==============================================================================
# Google OAuth 2.0 (Identity Provider)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================================================
# Google Gemini API
# ==============================================================================
# Single API Key or comma-separated list for rotation pool
GEMINI_API_KEY=your_primary_gemini_api_key
GEMINI_API_KEYS=key_1,key_2,key_3

# ==============================================================================
# Object Storage (SeaweedFS on VM / S3 Compatible - ADR-0003)
# ==============================================================================
# S3 Client Configuration for App (Compatible with SeaweedFS / Cloudflare R2 / AWS S3)
S3_ENDPOINT=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT=https://s3.yourdomain.com
S3_ACCESS_KEY_ID=any_access_key
S3_SECRET_ACCESS_KEY=any_secret_key
S3_BUCKET_NAME=ielts-audio-submissions
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true


