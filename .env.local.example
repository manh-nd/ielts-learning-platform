# ==============================================================================
# Database Configuration (Local Development via docker-compose.dev.yml)
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ielts_platform

# ==============================================================================
# Application & Better Auth (Local Dev)
# ==============================================================================
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=local_development_secret_32_chars_long_random_str
BETTER_AUTH_URL=http://localhost:3000
TEACHER_EMAILS=teacher@local.test,admin@local.test

# ==============================================================================
# Google OAuth (Optional in Local Dev if testing mock auth)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================================================
# Google Gemini API
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key

# ==============================================================================
# Cloudflare R2 (Audio Storage)
# ==============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ielts-audio-submissions
R2_PUBLIC_DOMAIN=http://localhost:3000
