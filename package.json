{
  "name": "ielts-learning-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "check:architecture": "bun run scripts/check-architecture.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns e2e",
    "test:homework:integration": "bun run scripts/test-homework-publication.ts",
    "test:unit": "bun test --path-ignore-patterns e2e",
    "test:storybook": "vitest --project=storybook --run",
    "test:visual": "docker run --rm --platform linux/amd64 --ipc=host -v $(pwd):/work -w /work mcr.microsoft.com/playwright:v1.62.1-noble ./node_modules/.bin/playwright test -c playwright.visual.config.ts",
    "test:visual:update": "docker run --rm --platform linux/amd64 --ipc=host -v $(pwd):/work -w /work mcr.microsoft.com/playwright:v1.62.1-noble ./node_modules/.bin/playwright test -c playwright.visual.config.ts --update-snapshots=changed",
    "test:visual:update:all": "docker run --rm --platform linux/amd64 --ipc=host -v $(pwd):/work -w /work mcr.microsoft.com/playwright:v1.62.1-noble ./node_modules/.bin/playwright test -c playwright.visual.config.ts --update-snapshots=all",
    "test:visual:local": "playwright test -c playwright.visual.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:seed": "bun run scripts/seed-users.ts",
    "purge:audio": "bun run scripts/purge-expired-audio.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:speaking:integration": "bun run scripts/test-speaking-persistence.ts",
    "test:speaking:live": "bun run scripts/smoke-speaking-live.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@base-ui/react": "^1.8.0",
    "@google/genai": "^2.23.0",
    "@shadcn/react": "^0.3.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-character-count": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "wavesurfer.js": "^7.12.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/runner": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
