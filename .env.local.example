# ==============================================================================
# Database Configuration (Local Development via docker-compose.dev.yml)
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ielts_platform

# ==============================================================================
# Application & Better Auth (Local Dev)
# ==============================================================================
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=local_development_secret_32_chars_long_random_str
BETTER_AUTH_URL=http://localhost:3000
TEACHER_EMAILS=teacher@local.test,admin@local.test

# ==============================================================================
# Google OAuth (Optional in Local Dev if testing mock auth)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================================================
# Google Gemini API
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key

# ==============================================================================
# Object Storage (Local SeaweedFS via docker-compose.dev.yml - ADR-0003)
# ==============================================================================
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=any_access_key
S3_SECRET_ACCESS_KEY=any_secret_key
S3_BUCKET_NAME=ielts-audio-submissions
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true


